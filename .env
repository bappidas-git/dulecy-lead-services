# ============================================
# Environment Variables — Dulcey Lead Services
# ============================================
# IMPORTANT: This .env file is COMMITTED to the repository (existing agency
# workflow). Because every value here is versioned in git, treat all secrets
# (admin password, leads admin key, and any future API keys) as already
# exposed — they MUST be rotated during and after the rebuild series before
# the site goes live.
#
# NOTE: Company/contact facts (name, phone, email, logos) are NOT read from
# .env — they live in src/data/siteConfig.js, the single source of business
# truth.
# ============================================

# Admin Panel Credentials (rotated for Dulcey in Prompt 01)
REACT_APP_ADMIN_USERNAME="dulecyadmin"
REACT_APP_ADMIN_PASSWORD="W5MU39xa8XT8c6XEFp2voCVM"

# Lead Storage (server-side single source of truth)
REACT_APP_LEADS_API_URL="/api/leads.php"
REACT_APP_LEADS_ADMIN_KEY="UjTUIwdxyIoXbCrEpsfEBvk0NFwqVeITfWpSzCY3uk3Z35Y0"

# ============================================
# Leads are stored server-side via /api/leads.php (the single source of truth).
# The admin panel reads/writes leads there so every browser/device stays in
# sync. REACT_APP_LEADS_ADMIN_KEY must match ADMIN_API_KEY on the server
# (public/api/config.php, or the committed fallback in leads.php).
# ============================================
